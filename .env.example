# Optional Linux/Windows cloud QA machines (defaults remain Cua / home PC).
# RAVEN_HOST_LINUX=devin-cloud
# RAVEN_HOST_WINDOWS=devin-cloud
# DEVIN_ORG_ID=org-...
# DEVIN_API_BASE_V3=https://api.devin.ai/v3
# RAVEN_DEVIN_TIMEOUT_S=1800
# RAVEN_DEVIN_MAX_ACU=10
# Copy to .env (never commit .env)
HAI_API_KEY=
HAI_MODEL=holo4-27b
GLADIA_API_KEY=
LINKUP_API_KEY=
DEVIN_API_KEY=
# Optional bearer token required by raven-core for remote clients (iOS over Tailscale)
RAVEN_TOKEN=
RAVEN_PORT=8787
# Windows worker: cua-spacesd on the home PC, reached over Tailscale
WINDOWS_WORKER_HOST=
# How H drives machines: models-loop (Holo4 via Models API, no session quota) | agents-api | local-runtime
RAVEN_H_MODE=models-loop
# Suspend unused test machines after N minutes (0 = never)
RAVEN_IDLE_SUSPEND_MIN=20
