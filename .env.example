# Copy to .env (never commit .env)
HAI_API_KEY=
HAI_MODEL=holo4-27b
GLADIA_API_KEY=
LINKUP_API_KEY=
DEVIN_API_KEY=
# Optional bearer token required by raven-core for remote clients (iOS over Tailscale)
RAVEN_TOKEN=
RAVEN_PORT=8787
# Windows worker: cua-spacesd on the home PC, reached over Tailscale
WINDOWS_WORKER_HOST=
# How H drives machines: models-loop (Holo4 via Models API, no session quota) | agents-api | local-runtime
RAVEN_H_MODE=models-loop
# Suspend unused test machines after N minutes (0 = never)
RAVEN_IDLE_SUSPEND_MIN=20
