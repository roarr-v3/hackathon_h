# Copy to .env (never commit .env)
HAI_API_KEY=
GLADIA_API_KEY=
LINKUP_API_KEY=
# v3 credentials for cloud planning and Devin Linux/Windows VMs.
# Windows is Devin-only and requires organization platform access.
# Local planning instead uses an authenticated Devin CLI and a trusted target repository.
DEVIN_API_KEY=
DEVIN_ORG_ID=
# Optional local planner overrides (not VM SSH configuration):
# DEVIN_CLI=devin
# DEVIN_PLANNING_MODEL=opus

# Initial seeds only when artifacts/execution.json is absent.
# Sidebar Execution / PUT /execution is authoritative; saves affect future runs without restart.
# Legacy Settings H-mode/model saves are rejected. H mode is independent of the machine backend.
RAVEN_PLANNER_MODE=local
RAVEN_H_MODE=auto
HAI_MODEL=holo4-27b
RAVEN_LINUX_SANDBOX=raven-linux-apple
# auto: agents-api on Linux/Windows, local-runtime on native macOS/Device Hub.
# Linux uses the existing Apple Container Space, never Docker/Colima. Profiles control fallback.

# Optional bearer token required by raven-core for remote clients (iOS over Tailscale)
RAVEN_TOKEN=
RAVEN_PORT=8787
# Planning, target preparation, and same-session repair have separate deadlines.
RAVEN_PLANNING_TIMEOUT_S=90
RAVEN_PREPARE_TIMEOUT_S=300
RAVEN_FIX_TIMEOUT_S=300
# Layered deadlines (models-loop): one Holo request < one agent (a spec's timeout_s) < the whole run.
# Every request is logged when sent, answered, or retried; a stuck request is abandoned and resent.
HAI_REQUEST_TIMEOUT_S=45
HAI_REQUEST_ATTEMPTS=3
RAVEN_AGENT_TIMEOUT_S=600
RAVEN_RUN_TIMEOUT_S=900
# Suspend idle local Spaces Raven created/resumed after N minutes (0 = never).
RAVEN_IDLE_SUSPEND_MIN=20
